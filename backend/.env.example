# ==============================================================================
# DRISHTI AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Architecture Flow:
#   PostgreSQL Database  ──>  SQLAlchemy ORM  ──>  FastAPI Backend (DRISHTI AI)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# Options: 'development', 'staging', 'production'
# - development : Allows local SQLite fallback for offline developer testing.
# - production  : Strictly requires a valid PostgreSQL DATABASE_URL. SQLite fallback is disabled.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL REQUIRED for Production)
# ------------------------------------------------------------------------------
# Production PostgreSQL Connection URI format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>?sslmode=require
#
# Render-managed PostgreSQL format:
# postgres://<username>:<password>@<host>/<database_name>
# (SQLAlchemy automatically translates postgres:// to postgresql://)
#
# For Local Development ONLY:
# DATABASE_URL=sqlite:///backend/data/drishti_auth.db
#
DATABASE_URL=postgresql://drishti_user:your_secure_password@localhost:5432/drishti_ai

# Database Pool Settings (Tuned for Production PostgreSQL on Render/Cloud)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a strong random 256-bit secret key for production JWT signing
JWT_SECRET_KEY=your-production-256-bit-secret-key-placeholder
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Account Seed (Optional overrides - never commit real passwords)
INITIAL_ADMIN_USERNAME=vibhu
INITIAL_ADMIN_PASSWORD=your-initial-admin-password-placeholder
INITIAL_ADMIN_EMAIL=vagelavibhu2007@gmail.com

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$|^https:\/\/.*\.onrender\.com$|^https:\/\/.*\.railway\.app$

# ------------------------------------------------------------------------------
# 5. MACHINE LEARNING & STORAGE PATHS
# ------------------------------------------------------------------------------
ML_MODE=real
DATASET_PATH=backend/data/ML_READY.csv
UPLOAD_DIR=uploads
