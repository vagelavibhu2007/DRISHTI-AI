{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://drishti-ai-r9gq.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://drishti-ai-r9gq.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

