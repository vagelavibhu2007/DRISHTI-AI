# ==========================================
# DRISHTI AI — ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# FRONTEND (Vite / Vercel Environment Variables)
# ------------------------------------------
# Set this in Vercel Dashboard -> Settings -> Environment Variables
# In production, set to your deployed backend URL (e.g. https://drishti-ai-backend.onrender.com/api)
# In local development, you can omit or set to http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# ------------------------------------------
# BACKEND (FastAPI / Render / Railway Variables)
# ------------------------------------------
PORT=8000
ML_MODE=real
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$|^https:\/\/.*\.onrender\.com$|^https:\/\/.*\.railway\.app$
DATABASE_URL=sqlite:///./backend/data/drishti_auth.db
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
